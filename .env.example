# Local development: durable PGlite PostgreSQL data in .runtime, local email preview.
APP_MODE=local
AUTH_ORIGIN=http://localhost:3000
## Optional, local mode only: test on this exact loopback origin while AUTH_ORIGIN remains the public HTTPS domain.
# AUTH_LOCAL_TEST_ORIGIN=http://localhost:3000
# Optional local preview over a user-controlled HTTPS tunnel (for example SakuraFrp).
# Keep this disabled for ordinary local development; do not use it as a production substitute.
# AUTH_ORIGIN=https://your-preview-host.example
# AUTH_ALLOW_PUBLIC_LOCAL_ORIGIN=true

# Connected mode: APP_MODE=connected; HTTPS origin; actual PostgreSQL and email.
# DATABASE_URL=
# AUTH_CODE_PEPPER=at-least-32-bytes-of-random-secret-set-outside-source
# AUTH_EMAIL_FROM=
# RESEND_API_KEY=
# Resend also works in local mode over HTTPS/SakuraFrp. Supply both values;
# AUTH_EMAIL_FROM must be an address on your Resend-verified sending domain.
# A public tunnel never exposes the development mailbox or pretends email was sent.
# Without a domain, use a QQ mailbox's SMTP authorization code (not its login password).
# AUTH_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-mailbox@qq.com
# SMTP_PASSWORD=
# AUTH_EMAIL_FROM is optional for SMTP; when set it must use SMTP_USER's address.
# An empty SMTP_PASSWORD leaves delivery unavailable until setup is complete.
# AUTH_GLOBAL_SEND_LIMIT=200
# AUTH_GLOBAL_VERIFICATION_LIMIT=500
# These are whole-site budgets per 15 minutes until a trusted transport client-key is configured.

# Generic OpenAI-compatible JSON API: rule analysis, assessment, assignment, plans, retrospective.
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=8192
# AI_TOKEN_PARAMETER=max_tokens
# AI_DAILY_PROJECT_CALL_LIMIT=40
# AI_DAILY_PROJECT_BUDGET_MICRO_USD=
# AI_INPUT_MICRO_USD_PER_MILLION=
# AI_OUTPUT_MICRO_USD_PER_MILLION=
# Prices must match the configured provider. Without prices, fees remain unknown; calls remain capped.

# Actual official DeepSeek Harness, installed on the BACKEND with npm run dsh:install.
# Or use an installed Windows Desktop DSH (account mode, isolated backend sessions):
# AI_PROVIDER=dsh
# DSH_DESKTOP_DIRECTORY=D:\dddsss
# DSH_DESKTOP_CREDENTIALS_FILE=C:\Users\your-user\.dsh\.credentials.yaml
# Linux/ARM server account mode uses the official Node runtime and a private grant file.
# DSH_ACCOUNT_CREDENTIALS_FILE=/run/secrets/dsh-account
# Select exactly one account/Desktop/API-key mode; never mix them.
# Set DSH_MODEL and the two DSH USD budget rates below; do not set DSH_API_KEY in account mode.
# AI_PROVIDER=dsh also routes rules, assessment, assignment, planning and retrospective through DSH.
# DSH_API_KEY=
# DSH_MODEL=
# DSH_BASE_URL=https://api.deepseek.com/anthropic
# DSH_INPUT_MICRO_USD_PER_MILLION=
# DSH_OUTPUT_MICRO_USD_PER_MILLION=
# DSH_TIMEOUT_MS=90000
# DSH_MAX_OUTPUT_TOKENS=8192
# DSH_DAILY_NAVIGATOR_CALL_LIMIT=40
# DSH_DAILY_NAVIGATOR_BUDGET_MICRO_USD=
# DSH_DAILY_SOURCE_CALL_LIMIT=20
# DSH_DAILY_SOURCE_BUDGET_MICRO_USD=2000000
# Rates above are required USD micros per million tokens. Read your account's actual rates.
# DSH_RUNTIME_PACKAGE_DIRECTORY=absolute/path/to/node_modules/@deepseek-ai/dsh

# Public web discovery: parent worker searches, safely fetches, then DSH analyzes.
# Native account search via the installed Windows Desktop DSH (no Brave key):
# DISCOVERY_PROVIDER=dsh_native
# DSH_SEARCH_MODEL=deepseek-v4-flash
# DSH_SEARCH_MAX_OUTPUT_TOKENS=2048
# DSH_SEARCH_MAX_USES=1
# DSH_SEARCH_INPUT_MICRO_USD_PER_MILLION=300000
# DSH_SEARCH_OUTPUT_MICRO_USD_PER_MILLION=1200000
# Conservative peak Flash rates, USD micros per million tokens; verify your billing.
# Default: two query groups for current/next two months, across public social sources.
# Native search counts as a paid model turn; unknown usage retains full reservation.
# API-key/container native search is not validated or enabled by this adapter.
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_COST_MICRO_USD_PER_CALL=
# Alternative without a search API key: periodically inspect supported official lists.
# DISCOVERY_PROVIDER=official_sources
# DISCOVERY_SOURCE_IDS_JSON=["ethglobal","lablab"]
# DISCOVERY_PROVIDER=brave uses the Brave keys above instead.
# DISCOVERY_QUERIES_JSON=["hackathon official open registration","黑客松 比赛 报名 官网"]
# DISCOVERY_MINIMUM_INTERVAL_MS=300000
# Smaller native batches reduce each round's conservative reservation.
# DISCOVERY_NATIVE_QUERIES_PER_CYCLE=1
# Daily operating target, not a promise of billable AI busy time; budget wins.
# DISCOVERY_COVERAGE_TARGET_HOURS=5
# npm run dev/start automatically starts backend workers with the server.
# Connected deployments with a separate npm run worker may disable embedded workers:
# FIELD_GUIDE_EMBEDDED_WORKERS=0
# DISCOVERY_RECRAWL_AFTER_MS=300000
# DISCOVERY_MAX_PAGES_PER_CYCLE=3
# DISCOVERY_RESULTS_PER_QUERY=10
# DISCOVERY_DAILY_SEARCH_CALL_LIMIT=144
# DISCOVERY_DAILY_MODEL_CALL_LIMIT=360
# DISCOVERY_DAILY_BUDGET_MICRO_USD=1000000
# DISCOVERY_FETCH_TIMEOUT_MS=15000
# DISCOVERY_MAX_PAGE_BYTES=262144
# Optional trusted LOCAL HTTP CONNECT proxy for source HTML/robots fetching only.
# Explicit loopback IP+port; no ambient proxy, credentials, remote proxy or TLS bypass.
# SOURCE_HTTP_PROXY=http://127.0.0.1:22321
# An always-running backend worker is required in connected mode: npm run worker.

# GitHub App user authorization (not a personal token or generic OAuth App).
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_TOKEN_ENCRYPTION_KEY=
# GITHUB_TOKEN_ENCRYPTION_KEY_ID=v1
# GITHUB_TOKEN_ENCRYPTION_PREVIOUS_KEYS={}
# Generate a random base64 32-byte AES key locally; do not commit it.
# Callback: AUTH_ORIGIN + /api/v1/github/authorization/callback
# Installation setup: AUTH_ORIGIN + /api/v1/github/installation/callback

# Optional trusted ingress attestation, generated by your proxy after stripping public headers.
# AUTH_PROXY_SIGNERS_JSON=[{"id":"ingress-a","signingKey":"private-at-least-32-byte-key"}]
# Without this, login endpoints share conservative whole-site client budgets.
# Never use NEXT_PUBLIC_* for any key. Copy this file to .env.local and fill it locally.
# Watcha login: register AUTH_ORIGIN + /api/v1/auth/guancha/callback in its console.
# Enable only after the registered callback and trusted public HTTPS are verified.
GUANCHA_LOGIN_ENABLED=false
GUANCHA_CLIENT_ID=
GUANCHA_CLIENT_SECRET=
GUANCHA_REDIRECT_URI=
# TEST_DATABASE_URL=isolated-test-postgres-connection (optional real two-client concurrency check)
# DSH-backed inspiration directory: one official site per due cycle, separate UTC-day allowance.
INSPIRATION_ENABLED=false
INSPIRATION_MINIMUM_INTERVAL_MS=60000
INSPIRATION_RECRAWL_AFTER_MS=86400000
INSPIRATION_DAILY_MODEL_CALL_LIMIT=24
INSPIRATION_DAILY_BUDGET_MICRO_USD=100000
