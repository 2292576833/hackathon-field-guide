import { writeFile } from "node:fs/promises";
import { createHash } from "node:crypto";
const definitions = [
  ["anthropics/skills", "683bc88e56f3e09ba94f7055977f3d3aa499f202", "frontend-design", "Apache-2.0"],
  ["anthropics/skills", "683bc88e56f3e09ba94f7055977f3d3aa499f202", "mcp-builder", "Apache-2.0"],
  ["anthropics/skills", "683bc88e56f3e09ba94f7055977f3d3aa499f202", "webapp-testing", "Apache-2.0"],
  ["github/awesome-copilot", "7cce7cfb4b61196c36d7e8eb8475ae84b356b126", "game-engine", "MIT"],
  ["github/awesome-copilot", "7cce7cfb4b61196c36d7e8eb8475ae84b356b126", "agent-architecture", "MIT"],
  ["github/awesome-copilot", "7cce7cfb4b61196c36d7e8eb8475ae84b356b126", "create-readme", "MIT"],
  ["github/awesome-copilot", "7cce7cfb4b61196c36d7e8eb8475ae84b356b126", "create-specification", "MIT"],
  ["github/awesome-copilot", "7cce7cfb4b61196c36d7e8eb8475ae84b356b126", "transloadit-media-processing", "MIT"],
] as const;
const trees = new Map<string, { path: string; mode: string; type: string }[]>();
