    const response = await fetch(downloadUrl, { redirect: "error", signal: AbortSignal.timeout(30_000) });
    if (!response.ok) throw new Error(`${file.repositoryPath}: ${response.status}`);
    const bytes = new Uint8Array(await response.arrayBuffer()); if (bytes.length > 2 * 1024 * 1024) throw new Error("Oversized file");
    if (file.repositoryPath === licensePath) { const text = new TextDecoder().decode(bytes); if (!text.includes(spdx === "MIT" ? "MIT License" : "Apache License")) throw new Error(`Unexpected license ${name}`); }
    files.push({ ...file, downloadUrl, sha256: createHash("sha256").update(bytes).digest("hex"), bytes: bytes.length });
