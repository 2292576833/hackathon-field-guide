for (const [repository, commit, name, spdx] of definitions) {
  const key = `${repository}/${commit}`;
  if (!trees.has(key)) { const response = await fetch(`https://api.github.com/repos/${repository}/git/trees/${commit}?recursive=1`); if (!response.ok) throw new Error(`Tree ${response.status}`); const tree = await response.json() as { tree: { path: string; mode: string; type: string }[]; truncated: boolean }; if (tree.truncated) throw new Error("Truncated tree"); trees.set(key, tree.tree); }
  const skillPath = `skills/${name}`;
