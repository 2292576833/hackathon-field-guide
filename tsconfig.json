{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-space-redesign/types/**/*.ts",
    ".next-space-redesign/dev/types/**/*.ts",
    ".next-canvas-final/types/**/*.ts",
    ".next-canvas-final/dev/types/**/*.ts",
    ".next-collaboration-review/types/**/*.ts",
    ".next-collaboration-review/dev/types/**/*.ts",
    ".next-usability-review/types/**/*.ts",
    ".next-usability-review/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
